generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        BigInt                    @id @default(autoincrement())
  fullName                  String                    @map("full_name") @db.VarChar(100)
  email                     String?                   @unique @db.VarChar(150)
  phone                     String?                   @unique @db.VarChar(20)
  avatar                    String?
  passwordHash              String?                   @map("password_hash") @db.VarChar(255)
  googleId                  String?                   @unique @map("google_id") @db.VarChar(255)
  appleId                   String?                   @unique @map("apple_id") @db.VarChar(255)
  facebookId                String?                   @unique @map("facebook_id") @db.VarChar(255)
  role                      UserRole
  status                    UserStatus                @default(active)
  workingStatus             String                    @default("offline") @map("working_status")
  lastSeen                  DateTime?                 @map("last_seen")
  lastLoginAt               DateTime?                 @map("last_login_at")
  latitude                  Decimal?                  @db.Decimal(10, 7)
  longitude                 Decimal?                  @db.Decimal(10, 7)
  pushToken                 String?                   @map("push_token") @db.VarChar(255)
  mfaEnabled                Boolean                   @default(false) @map("mfa_enabled")
  mfaSecret                 String?                   @map("mfa_secret") @db.VarChar(255)
  emailNotificationsEnabled Boolean                   @default(true) @map("email_notifications_enabled")
  pushNotificationsEnabled  Boolean                   @default(true) @map("push_notifications_enabled")
  createdAt                 DateTime                  @default(now()) @map("created_at")
  updatedAt                 DateTime                  @updatedAt @map("updated_at")
  auditLogs                 AuditLog[]
  statusChanges             BookingStatusLog[]
  bookingsAsCustomer        Booking[]                 @relation("CustomerBookings")
  cancellationsMade         Cancellation[]            @relation("CancelledBy")
  ownedCompanies            Company[]                 @relation("CompanyOwner")
  staffMemberships          CompanyStaff[]
  conversationParticipants  ConversationParticipant[]
  disputesAsCustomer        Dispute[]                 @relation("DisputeCustomer")
  messages                  Message[]
  notifications             Notification[]
  passwordResets            PasswordReset[]
  payments                  Payment[]
  refreshTokens             RefreshToken[]
  reviews                   Review[]
  savedItems                SavedItem[]
  serviceRequestsMade       ServiceRequest[]          @relation("CustomerRequests")
  addresses                 UserAddress[]
  supportTickets            SupportTicket[]
  supportTicketMessages     SupportTicketMessage[]
  moderationActions         ModerationLog[]
  writtenStaffNotes         StaffNote[]               @relation("NoteAuthor")
  instantRequests           InstantRequest[]          @relation("CustomerInstantRequests")

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

model EmailTemplate {
  id          Int      @id @default(autoincrement())
  templateId  String   @unique @map("template_id") @db.VarChar(100)
  name        String   @db.VarChar(150)
  description String?
  subject     String   @db.VarChar(255)
  body        String   @db.Text
  variables   Json     @default("[]")
  status      String   @default("active") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("email_templates")
}

model Company {
  id                      BigInt                 @id @default(autoincrement())
  name                    String                 @db.VarChar(150)
  description             String?
  registrationNumber      String?                @map("registration_number") @db.VarChar(50)
  address                 String?
  city                    String?                @db.VarChar(100)
  latitude                Decimal?               @db.Decimal(10, 7)
  longitude               Decimal?               @db.Decimal(10, 7)
  googleMapUrl            String?                @map("google_map_url") @db.Text
  phone                   String?                @db.VarChar(20)
  email                   String?                @db.VarChar(150)
  ownerId                 BigInt                 @map("owner_id")
  verificationStatus      VerificationStatus     @default(pending) @map("verification_status")
  logoUrl                 String?
  coverImageUrl           String?
  verificationDocumentUrl String?                @map("verification_document_url")
  establishedYear         Int?
  cardHighlights          Json                   @default("[]")
  detailHighlights        Json                   @default("[]")
  subscriptionStatus      String                 @default("trial") @map("subscription_status") @db.VarChar(50)
  trialEndsAt             DateTime?              @map("trial_ends_at")
  nextBillingDate         DateTime?              @map("next_billing_date")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")
  walletBalance           Decimal                @default(0) @map("wallet_balance") @db.Decimal(10, 2)
  khqrImageUrl            String?                @map("khqr_image_url") @db.Text
  pendingBalance          Decimal                @default(0) @map("pending_balance") @db.Decimal(10, 2)
  availableBalance        Decimal                @default(0) @map("available_balance") @db.Decimal(10, 2)
  platformFeePercent      Decimal?               @map("platform_fee_percent") @db.Decimal(5, 2)
  completedJobs           Int                    @default(0) @map("completed_jobs")
  isInsured               Boolean                @default(false) @map("is_insured")
  completionRate          Decimal                @default(100.0) @map("completion_rate") @db.Decimal(5, 2)
  coverageRadiusKm        Int                    @default(50) @map("coverage_radius_km")
  bookingMode             String                 @default("dispatch") @map("booking_mode") @db.VarChar(20)
  availabilitySlots       AvailabilitySlot[]
  bookings                Booking[]
  owner                   User                   @relation("CompanyOwner", fields: [ownerId], references: [id])
  paymentMethods          CompanyPaymentMethod[] @relation("CompanyPaymentMethods")
  ratingSummary           CompanyRatingSummary?
  staff                   CompanyStaff[]
  conversations           Conversation[]
  disputes                Dispute[]              @relation("DisputeCompany")
  campaigns               MarketingCampaign[]
  payouts                 Payout[]               @relation("CompanyPayouts")
  serviceAreas            ServiceArea[]
  serviceRequests         ServiceRequest[]
  services                Service[]
  pricingRules            PricingRule[]
  complianceReports       ComplianceReport[]
  instantRequestBids      InstantRequestBid[]

  @@index([verificationStatus])
  @@index([subscriptionStatus])
  @@index([ownerId], map: "fk_company_owner")
  @@map("companies")
}

model CompanyStaff {
  id                 BigInt               @id @default(autoincrement())
  companyId          BigInt               @map("company_id")
  userId             BigInt               @map("user_id")
  role               StaffRole
  status             StaffStatus          @default(active)
  createdAt          DateTime             @default(now())
  creditLimit        Decimal              @default(-50) @map("credit_limit") @db.Decimal(10, 2)
  walletBalance      Decimal              @default(0) @map("wallet_balance") @db.Decimal(10, 2)
  khqrImageUrl       String?              @map("khqr_image_url") @db.Text
  splitPercent       Decimal?             @map("split_percent") @db.Decimal(5, 2)
  availabilitySlots  AvailabilitySlot[]
  assignedBookings   Booking[]            @relation("AssignedBookings")
  company            Company              @relation(fields: [companyId], references: [id])
  user               User                 @relation(fields: [userId], references: [id])
  payouts            Payout[]             @relation("StaffPayouts")
  reviews            Review[]             @relation("StaffReviews")
  approvedRequests   ServiceRequest[]     @relation("ApprovedBy")
  assignedRequests   ServiceRequest[]     @relation("AssignedStaff")
  rejectedRequests   ServiceRequest[]     @relation("RejectedBy")
  paymentMethods     StaffPaymentMethod[] @relation("StaffPaymentMethods")
  walletTransactions WalletTransaction[]  @relation("StaffWalletTransactions")
  documents          StaffDocument[]
  notes              StaffNote[]

  @@unique([companyId, userId])
  @@index([companyId], map: "fk_staff_company")
  @@index([userId], map: "fk_staff_user")
  @@map("company_staff")
}

model Category {
  id              BigInt         @id @default(autoincrement())
  name            String         @db.VarChar(100)
  slug            String         @unique @db.VarChar(100)
  description     String?
  icon            String?        @db.VarChar(50)
  imageUrl        String?        @map("image_url")
  useImageAsBadge Boolean        @default(false) @map("use_image_as_badge")
  status          CategoryStatus @default(active)
  displayOrder    Int            @default(0) @map("display_order")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  serviceTypes    ServiceType[]

  @@index([slug])
  @@map("categories")
}

model ServiceType {
  id           BigInt         @id @default(autoincrement())
  categoryId   BigInt         @map("category_id")
  name         String         @db.VarChar(150)
  slug         String         @unique @db.VarChar(150)
  description  String?
  icon         String?        @db.VarChar(50)
  imageUrl     String?
  status       CategoryStatus @default(active)
  displayOrder Int            @default(0) @map("display_order")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  category     Category       @relation(fields: [categoryId], references: [id])
  services     Service[]

  @@index([categoryId], map: "fk_servicetype_category")
  @@index([slug])
  @@map("service_types")
}

model Service {
  id              BigInt           @id @default(autoincrement())
  companyId       BigInt           @map("company_id")
  serviceTypeId   BigInt           @map("service_type_id")
  name            String           @db.VarChar(150)
  image           String?
  description     String?
  basePrice       Decimal          @map("base_price") @db.Decimal(10, 2)
  discountPrice   Decimal?         @map("discount_price") @db.Decimal(10, 2)
  features        Json?
  checklist       Json?
  durationMin     Int              @map("duration_min")
  durationMax     Int?             @map("duration_max")
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  bookings        Booking[]
  serviceRequests ServiceRequest[]
  company         Company          @relation(fields: [companyId], references: [id])
  serviceType     ServiceType      @relation(fields: [serviceTypeId], references: [id])

  @@index([companyId], map: "fk_service_company")
  @@index([serviceTypeId], map: "fk_service_servicetype")
  @@index([isActive, companyId], map: "idx_service_active_company")
  @@index([isActive, serviceTypeId], map: "idx_service_active_type")
  @@map("services")
}

model ServiceArea {
  id               BigInt  @id @default(autoincrement())
  companyId        BigInt  @map("company_id")
  city             String  @db.VarChar(100)
  coverageRadiusKm Int?    @map("coverage_radius_km")
  company          Company @relation(fields: [companyId], references: [id])

  @@index([companyId], map: "fk_area_company")
  @@map("service_areas")
}

model ServiceRequest {
  id              BigInt               @id @default(autoincrement())
  customerId      BigInt               @map("customer_id")
  companyId       BigInt               @map("company_id")
  serviceId       BigInt               @map("service_id")
  assignedStaffId BigInt?              @map("assigned_staff_id")
  requestedDate   DateTime             @map("requested_date") @db.Date
  requestedTime   DateTime?            @map("requested_time") @db.Time(6)
  serviceAddress  String               @map("service_address")
  latitude        Decimal?             @db.Decimal(10, 7)
  longitude       Decimal?             @db.Decimal(10, 7)
  status          ServiceRequestStatus @default(pending)
  notes           String?
  approvedAt      DateTime?            @map("approved_at")
  approvedBy      BigInt?              @map("approved_by")
  rejectedAt      DateTime?            @map("rejected_at")
  rejectedBy      BigInt?              @map("rejected_by")
  rejectionReason String?              @map("rejection_reason")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  approver        CompanyStaff?        @relation("ApprovedBy", fields: [approvedBy], references: [id])
  assignedStaff   CompanyStaff?        @relation("AssignedStaff", fields: [assignedStaffId], references: [id])
  company         Company              @relation(fields: [companyId], references: [id])
  customer        User                 @relation("CustomerRequests", fields: [customerId], references: [id])
  rejecter        CompanyStaff?        @relation("RejectedBy", fields: [rejectedBy], references: [id])
  service         Service              @relation(fields: [serviceId], references: [id])

  @@index([customerId], map: "fk_request_customer")
  @@index([companyId], map: "fk_request_company")
  @@index([serviceId], map: "fk_request_service")
  @@index([assignedStaffId], map: "fk_request_assigned_staff")
  @@index([approvedBy], map: "fk_request_approved_by")
  @@index([rejectedBy], map: "fk_request_rejected_by")
  @@index([companyId, status], map: "idx_request_company_status")
  @@index([customerId, status], map: "idx_request_customer_status")
  @@map("service_requests")
}

model AvailabilitySlot {
  id          BigInt        @id @default(autoincrement())
  companyId   BigInt        @map("company_id")
  staffId     BigInt?       @map("staff_id")
  date        DateTime      @db.Date
  startTime   DateTime      @map("start_time") @db.Time(6)
  endTime     DateTime      @map("end_time") @db.Time(6)
  isAvailable Boolean       @default(true) @map("is_available")
  company     Company       @relation(fields: [companyId], references: [id])
  staff       CompanyStaff? @relation(fields: [staffId], references: [id])

  @@index([companyId], map: "fk_slot_company")
  @@index([staffId], map: "fk_slot_staff")
  @@index([companyId, date], map: "idx_slot_company_date")
  @@map("availability_slots")
}

model Booking {
  id                  BigInt              @id @default(autoincrement())
  customerId          BigInt              @map("customer_id")
  companyId           BigInt              @map("company_id")
  serviceId           BigInt              @map("service_id")
  assignedStaffId     BigInt?             @map("assigned_staff_id")
  bookingDate         DateTime            @map("booking_date") @db.Date
  startTime           DateTime            @map("start_time") @db.Time(6)
  endTime             DateTime            @map("end_time") @db.Time(6)
  actualStartTime     DateTime?           @map("actual_start_time")
  actualEndTime       DateTime?           @map("actual_end_time")
  serviceAddress      String              @map("service_address")
  latitude            Decimal?            @db.Decimal(10, 7)
  longitude           Decimal?            @db.Decimal(10, 7)
  staffStartLatitude  Decimal?            @map("staff_start_latitude") @db.Decimal(10, 7)
  staffStartLongitude Decimal?            @map("staff_start_longitude") @db.Decimal(10, 7)
  status              BookingStatus       @default(pending)
  progressPercent     Int                 @default(0) @map("progress_percent")
  checklist           Json?
  proofOfWorkPhoto    String?             @map("proof_of_work_photo")
  staffNotes          String?             @map("staff_notes")
  totalPrice          Decimal             @map("total_price") @db.Decimal(10, 2)
  platformFee         Decimal             @db.Decimal(10, 2)
  companyEarnings     Decimal             @db.Decimal(10, 2)
  staffEarnings       Decimal             @default(0) @db.Decimal(10, 2)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  customerNotes       String?             @map("customer_notes")
  promoCodeId         BigInt?             @map("promo_code_id")
  statusLogs          BookingStatusLog[]
  assignedStaff       CompanyStaff?       @relation("AssignedBookings", fields: [assignedStaffId], references: [id])
  company             Company             @relation(fields: [companyId], references: [id])
  customer            User                @relation("CustomerBookings", fields: [customerId], references: [id])
  service             Service             @relation(fields: [serviceId], references: [id])
  promoCode           PromoCode?          @relation(fields: [promoCodeId], references: [id])
  cancellation        Cancellation?
  dispute             Dispute?
  invoice             Invoice?
  payment             Payment?
  review              Review?
  walletTransactions  WalletTransaction[] @relation("BookingWalletTransactions")
  conversations       Conversation[]

  @@index([customerId], map: "fk_booking_customer")
  @@index([companyId], map: "fk_booking_company")
  @@index([serviceId], map: "fk_booking_service")
  @@index([assignedStaffId], map: "fk_booking_assigned_staff")
  @@index([customerId, status], map: "idx_booking_customer_status")
  @@index([companyId, status], map: "idx_booking_company_status")
  @@index([companyId, bookingDate], map: "idx_booking_company_date")
  @@index([assignedStaffId, status], map: "idx_booking_staff_status")
  @@index([createdAt])
  @@map("bookings")
}

model BookingStatusLog {
  id        BigInt   @id @default(autoincrement())
  bookingId BigInt   @map("booking_id")
  oldStatus String?  @map("old_status") @db.VarChar(50)
  newStatus String?  @map("new_status") @db.VarChar(50)
  changedBy BigInt?  @map("changed_by")
  changedAt DateTime @default(now()) @map("changed_at")
  booking   Booking  @relation(fields: [bookingId], references: [id])
  user      User?    @relation(fields: [changedBy], references: [id])

  @@index([bookingId], map: "fk_log_booking")
  @@index([changedBy], map: "fk_log_user")
  @@map("booking_status_log")
}

model Payment {
  id             BigInt        @id @default(autoincrement())
  bookingId      BigInt        @unique @map("booking_id")
  userId         BigInt        @map("user_id")
  method         PaymentMethod
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("USD") @db.VarChar(10)
  status         PaymentStatus @default(pending)
  transactionRef String?       @map("transaction_ref") @db.VarChar(100)
  paidAt         DateTime?     @map("paid_at")
  booking        Booking       @relation(fields: [bookingId], references: [id])
  user           User          @relation(fields: [userId], references: [id])

  @@index([bookingId], map: "fk_payment_booking")
  @@index([userId], map: "fk_payment_user")
  @@index([transactionRef], map: "idx_payment_transaction_ref")
  @@index([status])
  @@map("payments")
}

model Review {
  id             BigInt        @id @default(autoincrement())
  bookingId      BigInt        @unique @map("booking_id")
  customerId     BigInt        @map("customer_id")
  companyRating  Int           @map("company_rating")
  companyComment String?       @map("company_comment")
  staffId        BigInt?       @map("staff_id")
  staffRating    Int?          @map("staff_rating")
  staffComment   String?       @map("staff_comment")
  createdAt      DateTime      @default(now()) @map("created_at")
  booking        Booking       @relation(fields: [bookingId], references: [id])
  customer       User          @relation(fields: [customerId], references: [id])
  staff          CompanyStaff? @relation("StaffReviews", fields: [staffId], references: [id])

  @@index([staffId])
  @@index([bookingId], map: "fk_review_booking")
  @@index([customerId], map: "fk_review_customer")
  @@map("reviews")
}

model Cancellation {
  id          BigInt   @id @default(autoincrement())
  bookingId   BigInt   @unique @map("booking_id")
  cancelledBy BigInt   @map("cancelled_by")
  reason      String?
  cancelledAt DateTime @default(now()) @map("cancelled_at")
  booking     Booking  @relation(fields: [bookingId], references: [id])
  user        User     @relation("CancelledBy", fields: [cancelledBy], references: [id])

  @@index([bookingId], map: "fk_cancel_booking")
  @@index([cancelledBy], map: "fk_cancel_user")
  @@map("cancellations")
}

model CompanyRatingSummary {
  companyId     BigInt   @id @map("company_id")
  averageRating Decimal? @map("average_rating") @db.Decimal(3, 2)
  totalReviews  Int      @default(0) @map("total_reviews")
  lastUpdated   DateTime @default(now()) @map("last_updated")
  company       Company  @relation(fields: [companyId], references: [id])

  @@index([companyId], map: "fk_rating_company")
  @@map("company_ratings_summary")
}

model Notification {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  title     String   @db.VarChar(200)
  body      String
  type      String   @default("info") @db.VarChar(50)
  isRead    Boolean  @default(false) @map("is_read")
  link      String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "fk_notify_user")
  @@index([userId, isRead], map: "idx_notify_user_unread")
  @@map("notifications")
}

model Conversation {
  id           BigInt                    @id @default(autoincrement())
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")
  companyId    BigInt?                   @map("company_id")
  // 'support' = Customer <-> Company (always open)
  // 'job'     = Customer <-> Assigned Staff (lifecycle-bound to a booking)
  type         String                    @default("support") @db.VarChar(20)
  bookingId    BigInt?                   @map("booking_id")
  archivedAt   DateTime?                 @map("archived_at")
  participants ConversationParticipant[]
  company      Company?                  @relation(fields: [companyId], references: [id])
  booking      Booking?                  @relation(fields: [bookingId], references: [id])
  messages     Message[]

  @@index([companyId], map: "fk_conversation_company")
  @@index([bookingId], map: "fk_conversation_booking")
  @@index([type])
  @@map("conversations")
}

model ConversationParticipant {
  id             BigInt       @id @default(autoincrement())
  conversationId BigInt       @map("conversation_id")
  userId         BigInt       @map("user_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([userId], map: "fk_conversation_participant_user")
  @@index([conversationId], map: "fk_conversation_participant_conversation")
  @@map("conversation_participants")
}

model Message {
  id             BigInt       @id @default(autoincrement())
  conversationId BigInt       @map("conversation_id")
  senderId       BigInt       @map("sender_id")
  content        String
  read           Boolean      @default(false)
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId], map: "fk_message_conversation")
  @@index([senderId], map: "fk_message_sender")
  @@index([conversationId, read], map: "idx_message_unread")
  @@map("messages")
}

model Invoice {
  id            BigInt   @id @default(autoincrement())
  bookingId     BigInt   @unique @map("booking_id")
  invoiceNumber String   @map("invoice_number") @db.VarChar(50)
  issuedAt      DateTime @default(now()) @map("issued_at")
  totalAmount   Decimal  @map("total_amount") @db.Decimal(10, 2)
  booking       Booking  @relation(fields: [bookingId], references: [id])

  @@index([bookingId], map: "fk_invoice_booking")
  @@map("invoices")
}

model MarketingCampaign {
  id          BigInt    @id @default(autoincrement())
  companyId   BigInt    @map("company_id")
  name        String    @db.VarChar(150)
  status      String    @default("active") @db.VarChar(50)
  budget      Decimal   @db.Decimal(10, 2)
  spent       Decimal   @default(0) @db.Decimal(10, 2)
  impressions Int       @default(0)
  clicks      Int       @default(0)
  conversions Int       @default(0)
  startDate   DateTime  @default(now()) @map("start_date")
  endDate     DateTime? @map("end_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "fk_campaign_company")
  @@map("marketing_campaigns")
}

model SystemSetting {
  id        BigInt   @id @default(autoincrement())
  keyName   String   @unique @map("key_name") @db.VarChar(100)
  value     String?
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("system_settings")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt?  @map("user_id")
  action     String?  @db.VarChar(150)
  entityType String?  @map("entity_type") @db.VarChar(100)
  entityId   BigInt?  @map("entity_id")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId], map: "fk_audit_user")
  @@index([entityType, entityId], map: "idx_audit_entity")
  @@map("audit_logs")
}

model PasswordReset {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  code      String   @db.VarChar(6)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "fk_password_reset_user")
  @@index([code], map: "idx_code")
  @@map("password_resets")
}

model OtpCode {
  id        BigInt   @id @default(autoincrement())
  phone     String?  @db.VarChar(20)
  email     String?  @db.VarChar(150)
  code      String   @db.VarChar(10)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone, code])
  @@index([email, code])
  @@map("otp_codes")
}

model SavedItem {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  itemType  String   @map("item_type") @db.VarChar(20)
  itemId    BigInt   @map("item_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
  @@index([userId], map: "fk_saved_user")
  @@index([itemType, itemId], map: "idx_saved_item")
  @@map("saved_items")
}

model UserAddress {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  label     String   @db.VarChar(50)
  address   String
  isDefault Boolean  @default(false) @map("is_default")
  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "fk_user_address_user")
  @@map("user_addresses")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(512)
  userId    BigInt   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "fk_refresh_token_user")
  @@map("refresh_tokens")
}

model Dispute {
  id              Int       @id @default(autoincrement())
  bookingId       BigInt    @unique @map("booking_id")
  customerId      BigInt    @map("customer_id")
  companyId       BigInt    @map("company_id")
  type            String    @db.VarChar(50)
  description     String
  photos          String?
  status          String    @default("open") @db.VarChar(20)
  companyResponse String?   @map("company_response")
  adminDecision   String?   @map("admin_decision") @db.VarChar(50)
  refundAmount    Decimal?  @map("refund_amount") @db.Decimal(10, 2)
  frozenAmount    Decimal?  @map("frozen_amount") @db.Decimal(10, 2)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  resolvedAt      DateTime? @map("resolved_at")
  booking         Booking   @relation(fields: [bookingId], references: [id])
  company         Company   @relation("DisputeCompany", fields: [companyId], references: [id])
  customer        User      @relation("DisputeCustomer", fields: [customerId], references: [id])

  @@index([bookingId], map: "fk_dispute_booking")
  @@index([customerId], map: "fk_dispute_customer")
  @@index([companyId], map: "fk_dispute_company")
  @@map("disputes")
}

model Payout {
  id            Int           @id @default(autoincrement())
  companyId     BigInt?       @map("company_id")
  staffId       BigInt?       @map("staff_id")
  payoutType    String        @default("company") @map("payout_type") @db.VarChar(20)
  amount        Decimal       @db.Decimal(10, 2)
  status        String        @default("pending") @db.VarChar(20)
  method        String        @db.VarChar(50)
  transactionId String?       @map("transaction_id") @db.VarChar(100)
  requestedAt   DateTime      @default(now()) @map("requested_at")
  processedAt   DateTime?     @map("processed_at")
  company       Company?      @relation("CompanyPayouts", fields: [companyId], references: [id])
  staff         CompanyStaff? @relation("StaffPayouts", fields: [staffId], references: [id])

  @@index([companyId], map: "fk_payout_company")
  @@index([staffId], map: "fk_payout_staff")
  @@map("payouts")
}

model CompanyPaymentMethod {
  id            Int      @id @default(autoincrement())
  companyId     BigInt   @map("company_id")
  type          String   @db.VarChar(20)
  accountName   String   @map("account_name") @db.VarChar(150)
  accountNumber String   @map("account_number") @db.VarChar(255)
  routingNumber String?  @map("routing_number") @db.VarChar(50)
  qrCodeUrl     String?  @map("qr_code_url")
  isDefault     Boolean  @default(false) @map("is_default")
  isVerified    Boolean  @default(false) @map("is_verified")
  createdAt     DateTime @default(now()) @map("created_at")
  company       Company  @relation("CompanyPaymentMethods", fields: [companyId], references: [id])

  @@index([companyId], map: "fk_payment_method_company")
  @@map("company_payment_methods")
}

model StaffPaymentMethod {
  id            Int          @id @default(autoincrement())
  staffId       BigInt       @map("staff_id")
  type          String       @db.VarChar(20)
  accountName   String       @map("account_name") @db.VarChar(150)
  accountNumber String       @map("account_number") @db.VarChar(255)
  routingNumber String?      @map("routing_number") @db.VarChar(50)
  qrCodeUrl     String?      @map("qr_code_url")
  isDefault     Boolean      @default(false) @map("is_default")
  isVerified    Boolean      @default(false) @map("is_verified")
  createdAt     DateTime     @default(now()) @map("created_at")
  staff         CompanyStaff @relation("StaffPaymentMethods", fields: [staffId], references: [id])

  @@index([staffId], map: "fk_payment_method_staff")
  @@map("staff_payment_methods")
}

model WalletTransaction {
  id          BigInt       @id @default(autoincrement())
  staffId     BigInt       @map("staff_id")
  amount      Decimal      @db.Decimal(10, 2)
  type        String       @db.VarChar(20)
  description String?
  bookingId   BigInt?      @map("booking_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  booking     Booking?     @relation("BookingWalletTransactions", fields: [bookingId], references: [id])
  staff       CompanyStaff @relation("StaffWalletTransactions", fields: [staffId], references: [id])

  @@index([staffId])
  @@index([bookingId])
  @@map("wallet_transactions")
}

model Transaction {
  id          BigInt   @id @default(autoincrement())
  ownerType   String   @map("owner_type") @db.VarChar(20)
  ownerId     BigInt   @map("owner_id")
  amount      Decimal  @db.Decimal(10, 2)
  type        String   @db.VarChar(20)
  category    String   @db.VarChar(50)
  description String
  bookingId   BigInt?  @map("booking_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([ownerType, ownerId])
  @@index([bookingId])
  @@map("transactions")
}

model DepositRequest {
  id                 BigInt   @id @default(autoincrement())
  ownerType          String   @map("owner_type") @db.VarChar(20)
  ownerId            BigInt   @map("owner_id")
  amount             Decimal  @db.Decimal(10, 2)
  bankName           String   @map("bank_name") @db.VarChar(100)
  proofOfTransferUrl String   @map("proof_of_transfer_url")
  status             String   @default("pending") @db.VarChar(20)
  adminNotes         String?  @map("admin_notes")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([ownerType, ownerId])
  @@map("deposit_requests")
}

model PayoutRequest {
  id              BigInt   @id @default(autoincrement())
  ownerType       String   @map("owner_type") @db.VarChar(20)
  ownerId         BigInt   @map("owner_id")
  amount          Decimal  @db.Decimal(10, 2)
  destinationBank String   @map("destination_bank") @db.VarChar(100)
  accountName     String   @map("account_name") @db.VarChar(100)
  accountNumber   String   @map("account_number") @db.VarChar(50)
  status          String   @default("pending") @db.VarChar(20)
  adminNotes      String?  @map("admin_notes")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([ownerType, ownerId])
  @@map("payout_requests")
}

enum UserRole {
  customer
  company_admin
  staff
  admin
}

enum UserStatus {
  active
  inactive
  suspended
}

enum StaffRole {
  worker
  supervisor
  manager
}

enum StaffStatus {
  active
  inactive
}

enum VerificationStatus {
  pending
  verified
  rejected
}

enum CategoryStatus {
  active
  inactive
}

enum BookingStatus {
  pending
  assigned
  confirmed
  en_route
  arrived
  in_progress
  completed
  cancelled
}

enum PaymentMethod {
  cash
  card
  wallet
  paypal
  bank
}

enum PaymentStatus {
  pending
  unpaid
  processing
  paid
  escrow
  pending_release
  available
  withdrawn
  disputed
  failed
  refunded
}

enum ServiceRequestStatus {
  pending
  approved
  rejected
  cancelled
}

model PromoCode {
  id              BigInt    @id @default(autoincrement())
  code            String    @unique @db.VarChar(50)
  discountPercent Decimal   @map("discount_percent") @db.Decimal(5, 2)
  maxUses         Int?      @map("max_uses")
  usedCount       Int       @default(0) @map("used_count")
  expiresAt       DateTime? @map("expires_at")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  bookings        Booking[]

  @@map("promo_codes")
}

model PricingRule {
  id               Int     @id @default(autoincrement())
  companyId        BigInt  @map("company_id")
  name             String  @db.VarChar(100)
  dayOfWeek        Int?    @map("day_of_week")
  startHour        Int?    @map("start_hour")
  endHour          Int?    @map("end_hour")
  surchargePercent Decimal @map("surcharge_percent") @db.Decimal(5, 2)
  isActive         Boolean @default(true) @map("is_active")
  company          Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("pricing_rules")
}

model SupportTicket {
  id          BigInt    @id @default(autoincrement())
  userId      BigInt    @map("user_id")
  subject     String    @db.VarChar(200)
  description String
  status      String    @default("open") @db.VarChar(20)
  priority    String    @default("medium") @db.VarChar(20)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  resolvedAt  DateTime? @map("resolved_at")

  user User @relation(fields: [userId], references: [id])
  messages SupportTicketMessage[]

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

model ModerationLog {
  id         BigInt   @id @default(autoincrement())
  adminId    BigInt   @map("admin_id")
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   BigInt   @map("entity_id")
  action     String   @db.VarChar(50)
  reason     String
  status     String   @default("pending") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")

  admin User @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([entityType, entityId])
  @@index([status])
  @@map("moderation_logs")
}

model ComplianceReport {
  id          BigInt    @id @default(autoincrement())
  companyId   BigInt    @map("company_id")
  type        String    @db.VarChar(50)
  status      String    @default("pending") @db.VarChar(20)
  documentUrl String?   @map("document_url")
  notes       String?
  reviewedAt  DateTime? @map("reviewed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([status])
  @@map("compliance_reports")
}

model Broadcast {
  id        BigInt   @id @default(autoincrement())
  title     String   @db.VarChar(200)
  message   String
  audience  String   @db.VarChar(50) // 'all', 'companies', 'customers'
  sentAt    DateTime @default(now()) @map("sent_at")
  sentCount Int      @default(0) @map("sent_count")
  openRate  Int      @default(0) @map("open_rate")
  status    String   @default("sent") @db.VarChar(20) // 'sent', 'draft'
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("broadcasts")
}

model StaffDocument {
  id          BigInt       @id @default(autoincrement())
  staffId     BigInt       @map("staff_id")
  name        String       @db.VarChar(150)
  documentUrl String       @map("document_url")
  status      String       @default("pending") @db.VarChar(50)
  expiryDate  DateTime?    @map("expiry_date")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  staff       CompanyStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@map("staff_documents")
}

model StaffNote {
  id        BigInt       @id @default(autoincrement())
  staffId   BigInt       @map("staff_id")
  authorId  BigInt       @map("author_id")
  note      String       @db.Text
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  staff     CompanyStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  author    User         @relation("NoteAuthor", fields: [authorId], references: [id])

  @@index([staffId])
  @@index([authorId])
  @@map("staff_notes")
}

model SupportTicketMessage {
  id          BigInt        @id @default(autoincrement())
  ticketId    BigInt        @map("ticket_id")
  senderId    BigInt        @map("sender_id")
  senderName  String        @map("sender_name") @db.VarChar(150)
  senderRole  String        @map("sender_role") @db.VarChar(20)
  content     String
  createdAt   DateTime      @default(now()) @map("created_at")

  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender      User          @relation(fields: [senderId], references: [id])

  @@index([ticketId])
  @@index([senderId])
  @@map("support_ticket_messages")
}

model InstantRequest {
  id              BigInt              @id @default(autoincrement())
  customerId      BigInt              @map("customer_id")
  serviceCategory String              @map("service_category") @db.VarChar(100)
  description     String
  preferredTime   String              @map("preferred_time") @db.VarChar(20)
  latitude        Decimal             @db.Decimal(10, 7)
  longitude       Decimal             @db.Decimal(10, 7)
  status          String              @default("searching") @db.VarChar(20)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  customer        User                @relation("CustomerInstantRequests", fields: [customerId], references: [id])
  bids            InstantRequestBid[]

  @@index([customerId])
  @@index([status])
  @@map("instant_requests")
}

model InstantRequestBid {
  id            BigInt         @id @default(autoincrement())
  requestId     BigInt         @map("request_id")
  companyId     BigInt         @map("company_id")
  priceEstimate Decimal        @map("price_estimate") @db.Decimal(10, 2)
  etaMinutes    Int            @map("eta_minutes")
  status        String         @default("pending") @db.VarChar(20)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  request       InstantRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([companyId])
  @@map("instant_request_bids")
}

