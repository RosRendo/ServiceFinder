{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^uuid$": "<rootDir>/../src/common/mocks/uuid.mock.ts",
    "^expo-server-sdk$": "<rootDir>/../src/common/mocks/expo.mock.ts"
  }
}
