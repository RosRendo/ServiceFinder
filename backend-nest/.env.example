# ==============================================================
# 🚀 CORE SERVER SETTINGS
# ==============================================================
NODE_ENV=production
PORT=5000
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com
APP_NAME=ServiceFinder

# ==============================================================
# 🗄️ DATABASE & CACHE
# ==============================================================
# If using docker-compose:
# IMPORTANT: never commit real credentials here — generate fresh values locally
DB_PASSWORD=change_me_db_password
DATABASE_URL="postgresql://root:change_me_db_password@service-finder-db:5432/servicefinder?schema=public"
# Redis Connection Details
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==============================================================
# 🔐 SECURITY & AUTHENTICATION
# ==============================================================
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# 📲 SMS OTP (Twilio)
# Required for phone number login and verification flows
# Get credentials at: https://www.twilio.com/console
# ==============================================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid

# SMS provider selection: twilio (default) | http | mock
# 'http' = local Cambodian gateway (Seatel/Smart/Cellcard/MyTel) — much
# cheaper than Twilio per SMS. Configure SMS_HTTP_* and adjust the payload
# in src/common/sms/http-sms.provider.ts to match your provider's docs.
# 'mock' = log codes to the server console (development only).
SMS_PROVIDER=twilio
SMS_HTTP_URL=
SMS_HTTP_API_KEY=
SMS_HTTP_SENDER_ID=ServiceFinder
# Set to 'true' if your provider expects the key in an X-API-Key header
# instead of the JSON body.
SMS_HTTP_API_KEY_HEADER=

# ==============================================================
# 📧 SMTP / EMAIL CONFIGURATION
# ==============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM_EMAIL=no-reply@servicefinder.com

# ==============================================================
# 📸 MEDIA UPLOADS (Cloudinary)
# ==============================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==============================================================
# 💳 PAYMENT GATEWAYS (ABA & PayPal)
# ==============================================================
# --- ABA PayWay ---
# SandBox: https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/purchase
# Production: Ask ABA for their production gateway URL
ABA_API_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/purchase
ABA_MERCHANT_ID=your_aba_merchant_id
ABA_API_KEY=your_aba_api_key

# --- Wing Bank KHQR ---
WING_BASE_URL=https://stage-gateway.wingbank.com
WING_CLIENT_ID=your_wing_client_id
WING_CLIENT_SECRET=your_wing_client_secret
WING_CIPHER_KEY=your_wing_cipher_key

# --- KHQR / Bakong Payment ---
KHQR_MERCHANT_ID=your_khqr_merchant_id
KHQR_ACQUIRER_ID=DEV_BANK
KHQR_MERCHANT_NAME="Service Finder"
# Shared secret for the KHQR webhook (/api/payments/webhook/khqr).
# When set, callbacks MUST present it in the X-Webhook-Secret header (fail closed).
# Leave empty ONLY if the provider cannot send headers — endpoint is then unauthenticated.
KHQR_WEBHOOK_SECRET=

# --- Frontend Redirects (Used after successful payment) ---
FRONTEND_URL=http://localhost:3000

# ==============================================================
# 🔍 SEARCH ENGINE (Elasticsearch)
# ==============================================================
ELASTICSEARCH_NODE=http://localhost:9200

# ==============================================================
# 📊 THIRD-PARTY SIGN-IN (Google / Facebook Auth)
# ==============================================================
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id.apps.googleusercontent.com

# ==============================================================
# 📈 ANALYTICS & MONITORING (PostHog & Sentry)
# ==============================================================
# --- PostHog Analytics ---
POSTHOG_API_KEY=your_posthog_api_key
POSTHOG_HOST=https://us.i.posthog.com

# --- Sentry Error Monitoring ---
SENTRY_DSN=your_sentry_dsn