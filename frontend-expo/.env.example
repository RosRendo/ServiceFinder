# ==============================================================
# 🚀 CLIENT GATEWAY SETTINGS
# ==============================================================
# The URL of your NestJS backend API (e.g. http://localhost:5000 or https://api.yourdomain.com)
EXPO_PUBLIC_API_URL=http://localhost:5000

# ==============================================================
# 📱 EXPO SERVICES
# ==============================================================
# The projectId from your Expo Dashboard (EAS) for push notifications
EXPO_PUBLIC_PROJECT_ID=your-expo-project-id

# ==============================================================
# 🗺️ MAP SERVICES (Google Maps)
# ==============================================================
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ==============================================================
# 📊 THIRD-PARTY SIGN-IN (Google / Facebook Auth)
# ==============================================================
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id.apps.googleusercontent.com
EXPO_PUBLIC_FACEBOOK_APP_ID=your_facebook_app_id_here

# ==============================================================
# 📈 ANALYTICS & MONITORING (PostHog & Sentry)
# ==============================================================
# --- PostHog Analytics ---
EXPO_PUBLIC_POSTHOG_API_KEY=phc_your_posthog_client_key_here
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Sentry Error Monitoring ---
EXPO_PUBLIC_SENTRY_DSN=your_sentry_client_dsn_here
