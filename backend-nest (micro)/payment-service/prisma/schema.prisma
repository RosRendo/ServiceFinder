// PAYMENT SERVICE — Prisma Schema (PostgreSQL)
// Contains all models needed for payment processing (read from other services)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentMethod {
  cash
  card
  wallet
  paypal
  bank
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum BookingStatus {
  pending
  confirmed
  in_progress
  completed
  cancelled
}

model Payment {
  id             BigInt        @id @default(autoincrement())
  bookingId      BigInt        @unique @map("booking_id")
  userId         BigInt        @map("user_id")
  method         PaymentMethod
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("USD") @db.VarChar(10)
  status         PaymentStatus @default(pending)
  transactionRef String?       @map("transaction_ref") @db.VarChar(100)
  paidAt         DateTime?     @map("paid_at")

  @@index([bookingId])
  @@index([userId])
  @@map("payments")
}

// Read-only models from other services
model Booking {
  id              BigInt        @id @default(autoincrement())
  customerId      BigInt        @map("customer_id")
  companyId       BigInt        @map("company_id")
  serviceId       BigInt        @map("service_id")
  status          BookingStatus @default(pending)
  totalPrice      Decimal       @map("total_price") @db.Decimal(10, 2)
  platformFee     Decimal       @map("platform_fee") @db.Decimal(10, 2)

  @@index([customerId])
  @@index([companyId])
  @@index([serviceId])
  @@map("bookings")
}

model Company {
  id         BigInt   @id @default(autoincrement())
  ownerId    BigInt   @map("owner_id")
  name       String   @db.VarChar(150)
  email      String?  @db.VarChar(150)

  @@index([ownerId])
  @@map("companies")
}

model Service {
  id          BigInt    @id @default(autoincrement())
  companyId   BigInt    @map("company_id")
  name        String    @db.VarChar(150)
  basePrice   Decimal   @map("base_price") @db.Decimal(10, 2)

  @@index([companyId])
  @@map("services")
}

model User {
  id       BigInt  @id @default(autoincrement())
  fullName String  @map("full_name") @db.VarChar(100)
  email    String  @unique @db.VarChar(150)
  phone    String? @db.VarChar(20)

  @@map("users")
}

model Notification {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  title     String   @db.VarChar(200)
  body      String   @db.Text
  type      String   @default("info") @db.VarChar(50)
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("notifications")
}