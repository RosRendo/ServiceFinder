// COMPANY SERVICE — Prisma Schema (PostgreSQL)
// Owns: companies, company_staff, categories, service_types, services, service_areas

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  cleaner
  supervisor
}

enum StaffStatus {
  active
  inactive
}

enum VerificationStatus {
  pending
  verified
  rejected
}

enum CategoryStatus {
  active
  inactive
}

model Company {
  id                 BigInt             @id @default(autoincrement())
  name               String             @db.VarChar(150)
  description        String?
  registrationNumber String?            @map("registration_number") @db.VarChar(50)
  address            String?
  city               String?            @db.VarChar(100)
  latitude           Decimal?           @db.Decimal(10, 7)
  longitude          Decimal?           @db.Decimal(10, 7)
  phone              String?            @db.VarChar(20)
  email              String?            @db.VarChar(150)
  // ownerId is stored but NOT a FK (cross-service boundary — auth-service owns users)
  ownerId            BigInt             @map("owner_id")
  verificationStatus VerificationStatus @default(pending) @map("verification_status")
  logoUrl            String?
  coverImageUrl      String?
  establishedYear    Int?
  cardHighlights     Json               @default("[]")
  detailHighlights   Json               @default("[]")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  staff    CompanyStaff[]
  services Service[]
  areas    ServiceArea[]
  ratingSummary CompanyRatingSummary?

  @@index([ownerId])
  @@map("companies")
}

model CompanyStaff {
  id        BigInt      @id @default(autoincrement())
  companyId BigInt      @map("company_id")
  // userId stored but NOT FK (cross-service)
  userId    BigInt      @map("user_id")
  role      StaffRole
  status    StaffStatus @default(active)
  createdAt DateTime    @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
  @@map("company_staff")
}

model Category {
  id           BigInt         @id @default(autoincrement())
  name         String         @db.VarChar(100)
  slug         String         @unique @db.VarChar(100)
  description  String?
  icon         String?        @db.VarChar(50)
  imageUrl     String?        @map("image_url")
  status       CategoryStatus @default(active)
  displayOrder Int            @default(0) @map("display_order")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  serviceTypes ServiceType[]

  @@index([slug])
  @@map("categories")
}

model ServiceType {
  id           BigInt         @id @default(autoincrement())
  categoryId   BigInt         @map("category_id")
  name         String         @db.VarChar(150)
  slug         String         @unique @db.VarChar(150)
  description  String?
  icon         String?        @db.VarChar(50)
  imageUrl     String?
  status       CategoryStatus @default(active)
  displayOrder Int            @default(0) @map("display_order")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  category Category  @relation(fields: [categoryId], references: [id])
  services Service[]

  @@index([categoryId])
  @@index([slug])
  @@map("service_types")
}

model Service {
  id            BigInt  @id @default(autoincrement())
  companyId     BigInt  @map("company_id")
  serviceTypeId BigInt  @map("service_type_id")
  name          String  @db.VarChar(150)
  image         String?
  description   String?
  basePrice     Decimal @map("base_price") @db.Decimal(10, 2)
  features      Json?
  durationMin   Int     @map("duration_min")
  durationMax   Int?    @map("duration_max")
  isActive      Boolean @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company     Company     @relation(fields: [companyId], references: [id])
  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id])

  @@index([companyId])
  @@index([serviceTypeId])
  @@map("services")
}

model ServiceArea {
  id               BigInt @id @default(autoincrement())
  companyId        BigInt @map("company_id")
  city             String @db.VarChar(100)
  coverageRadiusKm Int?   @map("coverage_radius_km")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("service_areas")
}

model CompanyRatingSummary {
  companyId     BigInt   @id @map("company_id")
  averageRating Decimal? @map("average_rating") @db.Decimal(3, 2)
  totalReviews  Int      @default(0) @map("total_reviews")
  lastUpdated   DateTime @default(now()) @map("last_updated")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("company_ratings_summary")
}
