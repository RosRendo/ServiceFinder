# ==============================================================
# 🚀 CORE SERVER SETTINGS
# ==============================================================
NODE_ENV=production
PORT=5000
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com
APP_NAME=ServiceFinder

# ==============================================================
# 🗄️ DATABASE & CACHE (Docker Compose Config)
# ==============================================================
DB_PASSWORD=your_secure_db_password_here
DATABASE_URL="postgresql://root:your_secure_db_password_here@postgres-db:5432/servicefinder"
REDIS_URL="redis://redis:6379"

# ==============================================================
# 🔐 SECURITY & AUTHENTICATION
# ==============================================================
JWT_SECRET=super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=7d

# --- Twilio SMS Integration ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ==============================================================
# 📧 SMTP / EMAIL CONFIGURATION
# ==============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_EMAIL=no-reply@servicefinder.com

# ==============================================================
# 📸 MEDIA UPLOADS (Cloudinary)
# ==============================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==============================================================
# 💳 PAYMENT GATEWAYS (ABA & PayPal)
# ==============================================================
ABA_API_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/purchase
ABA_MERCHANT_ID=your_aba_merchant_id
ABA_API_KEY=your_aba_api_key
FRONTEND_URL=http://localhost:3000

# ==============================================================
# 📊 THIRD-PARTY SIGN-IN (Google / Facebook Auth)
# ==============================================================
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id.apps.googleusercontent.com
