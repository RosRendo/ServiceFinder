# ==============================================================
# 🚀 CORE SERVER SETTINGS
# ==============================================================
NODE_ENV=production
PORT=5000
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://your-web-dashboard.vercel.app
APP_NAME=ServiceFinder

# URL of your web dashboard (used in email links and ABA return URL)
FRONTEND_URL=https://your-web-dashboard.vercel.app

# ==============================================================
# 🗄️ DATABASE & CACHE
# ==============================================================
DB_PASSWORD=your_secure_db_password_here

# Full PostgreSQL connection string (Docker Compose uses service name "postgres-db")
DATABASE_URL="postgresql://root:your_secure_db_password_here@postgres-db:5432/servicefinder"

# Redis full URL (Docker Compose uses service name "redis")
REDIS_URL=redis://redis:6379

# Individual Redis params (used by some Redis adapters alongside REDIS_URL)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ==============================================================
# 🔐 SECURITY & AUTHENTICATION
# ==============================================================
JWT_SECRET=super_secret_jwt_key_min_32_chars_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=another_super_secret_for_refresh_tokens_change_this

# ==============================================================
# 📲 SMS OTP (Twilio)
# Required for phone number login and verification flows
# Get credentials at: https://www.twilio.com/console
# ==============================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ==============================================================
# 📧 SMTP / EMAIL (Nodemailer)
# Used for: password reset codes, staff welcome emails
# Supports Gmail or any SMTP provider (Resend, SendGrid, AWS SES)
# ==============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password-16-chars
SMTP_FROM_EMAIL=no-reply@servicefinder.com

# ==============================================================
# 📸 MEDIA UPLOADS (Cloudinary)
# Required for: company logos, service images, staff avatars
# Get credentials at: https://cloudinary.com/console
# ==============================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==============================================================
# 💳 PAYMENT GATEWAY (ABA PayWay - Cambodia)
# Required for: in-app customer checkout via ABA bank
# Sandbox URL is safe for testing. Switch to production URL for live.
# ==============================================================
ABA_API_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/purchase
ABA_MERCHANT_ID=your_aba_merchant_id
ABA_API_KEY=your_aba_api_key_secret

# KHQR Webhook — Shared secret for verifying KHQR payment webhook signatures
# Get this from your KHQR / BAKONG provider dashboard.
# ⚠️  REQUIRED: If this is missing, ALL KHQR webhooks will be rejected for security.
KHQR_WEBHOOK_SECRET=your_khqr_webhook_shared_secret

# ==============================================================
# 🔑 SOCIAL LOGIN (Google OAuth)
# Required for: Google Sign-In on web and mobile
# Get credentials at: https://console.cloud.google.com/apis/credentials
# ==============================================================
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id.apps.googleusercontent.com

# ==============================================================
# 📊 ANALYTICS & MONITORING
# Optional but highly recommended for production
# ==============================================================

# Sentry — Crash and error tracking (https://sentry.io)
# If not set, Sentry is silently disabled (app still works)
SENTRY_DSN=https://your_sentry_key@oXXXXX.ingest.sentry.io/XXXXXXX

# PostHog — User behavior and session analytics (https://posthog.com)
# If not set, PostHog tracking is silently disabled
POSTHOG_API_KEY=phc_your_posthog_project_api_key
POSTHOG_HOST=https://app.posthog.com

# ==============================================================
# 🔍 SEARCH (Elasticsearch)
# ⚠️  WARNING: Do NOT run Elasticsearch on a 1GB VPS — it needs 2GB+ RAM.
# Use a hosted provider like: https://bonsai.io (free tier) or Elastic Cloud.
# If this variable is not set, it falls back to http://localhost:9200 and
# the search module will fail silently.
# ==============================================================
ELASTICSEARCH_NODE=https://your-cluster.bonsai.io
